#!/usr/bin/env bash
# Re-runs whenever fish_plugins changes: {{ include "private_dot_config/private_fish/fish_plugins" | sha256sum }}
set -euo pipefail
command -v fish >/dev/null || exit 0
fisher_file="$HOME/.config/fish/functions/fisher.fish"
if [[ ! -f "$fisher_file" ]]; then
  mkdir -p "$(dirname "$fisher_file")"
  curl --fail --silent --show-error --location \
    https://raw.githubusercontent.com/jorgebucaran/fisher/4.4.8/functions/fisher.fish \
    --output "$fisher_file"
fi
fish -c 'fisher update' >/dev/null

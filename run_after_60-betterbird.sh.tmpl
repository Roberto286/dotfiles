{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Betterbird ignores the tray on desktops outside its built-in list; add niri.
# Profile dirs have random names and exist only after the first launch, so this
# runs on every apply (not run_onchange) and rewrites user.js only when it differs.
set -euo pipefail
want='user_pref("mail.minimizeToTray.supportedDesktops", "kde,gnome,ubuntu:gnome,pop:gnome,xfce,mate,hyprland,x-cinnamon,niri");'
for prefs in "$HOME"/.var/app/eu.betterbird.Betterbird/.thunderbird/*/prefs.js; do
    [[ -e $prefs ]] || continue
    user="$(dirname "$prefs")/user.js"
    [[ -e $user ]] && [[ "$(<"$user")" == "$want" ]] && continue
    printf '%s\n' "$want" > "$user"
done
{{- end }}
